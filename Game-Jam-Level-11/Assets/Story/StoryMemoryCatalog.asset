  m_Name: StoryMemoryCatalog
  m_EditorClassIdentifier: 
  entries:
  - id: memory_world
    title: "\u0422\u0451\u043F\u043B\u044B\u0439 \u043C\u0438\u0440"
    body: "\u041A\u043E\u0433\u0434\u0430-\u0442\u043E \u043D\u043E\u0447\u044C\u044E
      \u0437\u0434\u0435\u0441\u044C \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435
      \u0431\u044B\u043B\u043E \u0442\u0435\u043C\u043D\u043E. \u0412 \u043A\u0430\u0436\u0434\u043E\u043C
      \u043E\u043A\u043D\u0435 \u0433\u043E\u0440\u0435\u043B \u0441\u0432\u0435\u0442."
    symbol: "\u2727"
  - id: memory_storm
    title: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0448\u0442\u043E\u0440\u043C"
    body: "\u0412\u0435\u0442\u0435\u0440 \u043F\u0440\u0438\u0448\u0451\u043B \u0431\u0435\u0437
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F.
      \u041C\u044B \u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C \u0440\u0430\u0437\u0431\u0443\u0434\u0438\u0442\u044C
      \u043F\u043E\u0433\u0430\u0441\u0448\u0438\u0435 \u043C\u0430\u044F\u043A\u0438
      \u2014 \u0438 \u0432\u044B\u043F\u0443\u0441\u0442\u0438\u043B\u0438 \u0435\u0433\u043E
      \u0438\u0437 \u0441\u0430\u043C\u043E\u0439 \u0426\u0435\u043F\u0438."
    symbol: "\u224B"
  - id: memory_keeper
    title: "\u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u044C"
    body: "\u041E\u043D \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C
      \u0443 \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043E\u0447\u0430\u0433\u0430.
      \u041E\u043D \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0441\u0430\u043C
      \u043D\u0435 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0451\u0442 \u043D\u043E\u0447\u044C."
    symbol: "\u25C8"
  - id: memory_spark
    title: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0438\u0441\u043A\u0440\u0430"
    body: "\u041E\u043D \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B \u0435\u0451
      \u043D\u0435 \u0434\u043B\u044F \u0441\u0435\u0431\u044F. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F
      \u0438\u0441\u043A\u0440\u0430 \u0432\u0441\u0451 \u0435\u0449\u0451 \u043E\u0442\u0432\u0435\u0447\u0430\u043B\u0430
      \u043D\u0430 \u0437\u043E\u0432 \u0426\u0435\u043F\u0438 \u2014 \u0438 \u043E\u043D
      \u0432\u0435\u0440\u0438\u043B, \u0447\u0442\u043E \u043E\u0434\u043D\u0430\u0436\u0434\u044B
      \u043E\u043D\u0430 \u0437\u0430\u0436\u0436\u0451\u0442 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043E\u0433\u043D\u0438."
    symbol: "\u2736"
  - id: memory_lighthouse
    title: "\u0421\u0435\u043A\u0440\u0435\u0442 \u043C\u0430\u044F\u043A\u0430"
    body: "\u041C\u0430\u044F\u043A \u043D\u0435 \u0441\u043E\u0437\u0434\u0430\u0451\u0442
      \u043E\u0433\u043E\u043D\u044C. \u041E\u043D \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0442\u0435\u043C, \u043A\u0442\u043E
      \u0435\u0449\u0451 \u0433\u043E\u0440\u0438\u0442, \u043D\u0430\u0439\u0442\u0438
      \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430. \u0418 \u0433\u0434\u0435-\u0442\u043E
      \u0434\u0430\u043B\u0435\u043A\u043E \u0435\u0439 \u0443\u0436\u0435 \u043E\u0442\u0432\u0435\u0442\u0438\u043B\u0438."
    symbol: "\u25CE"
